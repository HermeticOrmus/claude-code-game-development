{
  "name": "game-development-meta-framework",
  "version": "1.0.0",
  "description": "Meta-prompting framework optimized for game development with Claude Code",
  "author": "manutej (meta-prompting-framework) + game-dev extensions",
  "repository": "https://github.com/HermeticOrmus/claude-code-game-development",
  "license": "MIT",
  "skills": [
    {
      "name": "analyze-complexity",
      "description": "Determine optimal meta-prompting strategy by analyzing task complexity (0.0-1.0)",
      "category": "analysis",
      "path": "skills/analyze-complexity/SKILL.md",
      "keywords": ["complexity", "routing", "strategy", "planning"]
    },
    {
      "name": "extract-context",
      "description": "Extract patterns, constraints, and success indicators from LLM outputs",
      "category": "analysis",
      "path": "skills/extract-context/SKILL.md",
      "keywords": ["context", "extraction", "patterns", "learning"]
    },
    {
      "name": "meta-prompt-iterate",
      "description": "Full recursive meta-prompting workflow with quality-driven iteration",
      "category": "generation",
      "path": "skills/meta-prompt-iterate/SKILL.md",
      "keywords": ["meta-prompting", "iteration", "improvement", "recursive"]
    },
    {
      "name": "assess-quality",
      "description": "Score output quality (0.0-1.0) against task requirements",
      "category": "validation",
      "path": "skills/assess-quality/SKILL.md",
      "keywords": ["quality", "assessment", "scoring", "validation"]
    },
    {
      "name": "game-system-generator",
      "description": "Generate complete game systems (physics, collision, input, animation, audio)",
      "category": "game-development",
      "path": "skills/game-system-generator/SKILL.md",
      "keywords": ["game", "physics", "collision", "input", "animation", "audio", "ECS"]
    },
    {
      "name": "game-architecture",
      "description": "Design game project architectures (ECS, State Machine, Scene Graph, Event-Driven)",
      "category": "game-development",
      "path": "skills/game-architecture/SKILL.md",
      "keywords": ["architecture", "ECS", "state machine", "game loop", "project structure"]
    },
    {
      "name": "category-master",
      "description": "Category theory patterns for compositional design",
      "category": "advanced",
      "path": "skills/category-master/SKILL.md",
      "keywords": ["category theory", "composition", "patterns"]
    },
    {
      "name": "discopy-categorical-computing",
      "description": "Categorical computing with DisCoPy for string diagrams",
      "category": "advanced",
      "path": "skills/discopy-categorical-computing/SKILL.md",
      "keywords": ["discopy", "string diagrams", "categorical"]
    },
    {
      "name": "nexus-tui-generator",
      "description": "Generate terminal user interfaces",
      "category": "generation",
      "path": "skills/nexus-tui-generator/SKILL.md",
      "keywords": ["TUI", "terminal", "interface"]
    }
  ],
  "agents": [
    {
      "name": "game-dev-agent",
      "description": "Specialized game development agent with meta-prompting capabilities",
      "path": "agents/GAME_DEV_AGENT.md",
      "model": "sonnet",
      "keywords": ["game", "development", "canvas", "webgl", "physics"]
    },
    {
      "name": "MARS",
      "description": "Meta-Agent Reasoning System for complex task decomposition",
      "path": "agents/MARS.md",
      "model": "opus",
      "keywords": ["reasoning", "decomposition", "planning"]
    },
    {
      "name": "MERCURIO",
      "description": "Meta-prompting orchestration agent",
      "path": "agents/MERCURIO.md",
      "model": "sonnet",
      "keywords": ["orchestration", "meta-prompting", "coordination"]
    },
    {
      "name": "meta2",
      "description": "Second-generation meta-prompting agent",
      "path": "agents/meta2/agent.md",
      "model": "sonnet",
      "keywords": ["meta", "iteration", "improvement"]
    }
  ],
  "commands": [
    {
      "name": "quick-improve",
      "description": "One-shot prompt improvement (single iteration)",
      "path": "commands/quick-improve.md"
    },
    {
      "name": "multi-stage",
      "description": "Research -> Plan -> Implement workflow",
      "path": "commands/multi-stage.md"
    },
    {
      "name": "grok",
      "description": "Deep understanding and analysis of code or concepts",
      "path": "commands/grok.md"
    },
    {
      "name": "meta-agent",
      "description": "Invoke meta-agent for complex reasoning",
      "path": "commands/meta-agent.md"
    },
    {
      "name": "meta-command",
      "description": "Execute meta-prompting workflow",
      "path": "commands/meta-command.md"
    },
    {
      "name": "game-prototype",
      "description": "Rapidly prototype a complete playable game",
      "path": "commands/game-prototype.md"
    }
  ],
  "workflows": [
    {
      "name": "production-ready",
      "description": "Full quality pipeline (3 iterations max, 0.90 threshold)",
      "path": "workflows/production-ready.yaml"
    },
    {
      "name": "rapid-iteration",
      "description": "Fast feedback loop (1-2 iterations, 0.85 threshold)",
      "path": "workflows/rapid-iteration.yaml"
    },
    {
      "name": "quick-meta-prompt",
      "description": "Quick meta-prompting workflow",
      "path": "workflows/quick-meta-prompt.yaml"
    },
    {
      "name": "meta-framework-generation",
      "description": "Generate meta-frameworks",
      "path": "workflows/meta-framework-generation.yaml"
    },
    {
      "name": "research-spec-generation",
      "description": "Generate research specifications",
      "path": "workflows/research-spec-generation.yaml"
    },
    {
      "name": "research-project-to-github",
      "description": "Convert research projects to GitHub repositories",
      "path": "workflows/research-project-to-github.yaml"
    },
    {
      "name": "startup-execution-plan",
      "description": "Generate startup execution plans",
      "path": "workflows/startup-execution-plan.yaml"
    }
  ],
  "engine": {
    "path": "../meta_prompting_engine/",
    "entry": "core.py",
    "components": [
      "complexity.py",
      "extraction.py",
      "llm_clients/base.py",
      "llm_clients/claude.py"
    ]
  },
  "requirements": {
    "python": ">=3.8",
    "dependencies": [
      "anthropic>=0.18.0",
      "python-dotenv>=1.0.0"
    ]
  },
  "configuration": {
    "default_max_iterations": 3,
    "default_quality_threshold": 0.90,
    "complexity_thresholds": {
      "simple": 0.3,
      "medium": 0.7
    },
    "strategies": {
      "simple": "direct_execution",
      "medium": "multi_approach_synthesis",
      "complex": "autonomous_evolution"
    },
    "game_development": {
      "default_fps_target": 60,
      "default_platform": "web",
      "default_architecture": "state-machine",
      "performance_threshold": 16.67
    }
  },
  "game_examples": [
    {
      "name": "pong",
      "description": "Classic paddle game with AI opponent",
      "complexity": 0.25,
      "systems": ["game-loop", "physics", "collision", "input", "ai"]
    },
    {
      "name": "snake",
      "description": "Grid-based snake game",
      "complexity": 0.30,
      "systems": ["grid", "collision", "input", "growth"]
    },
    {
      "name": "breakout",
      "description": "Brick breaker with power-ups",
      "complexity": 0.40,
      "systems": ["physics", "collision", "power-ups", "levels"]
    },
    {
      "name": "platformer",
      "description": "Side-scrolling platformer",
      "complexity": 0.65,
      "systems": ["physics", "collision", "tiles", "enemies", "camera"]
    },
    {
      "name": "tower-defense",
      "description": "Strategic tower defense",
      "complexity": 0.75,
      "systems": ["pathfinding", "waves", "economy", "towers", "projectiles"]
    }
  ],
  "testing": {
    "mock_validation": "../validate_implementation.py",
    "real_api_test": "../test_real_api.py",
    "demo": "../demo_meta_prompting.py"
  }
}
